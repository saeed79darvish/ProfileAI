# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=profileai
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# OpenAI Configuration (used for some job routes; optional if only using Voyage AI)
OPENAI_API_KEY=your_openai_api_key_here

# Voyage AI Configuration (for RAG-powered semantic search embeddings)
# Get your key at https://dash.voyageai.com/
VOYAGE_API_KEY=your_voyage_api_key_here

# CORS
CORS_ORIGIN=http://localhost:3000

# Adzuna Job Aggregator (optional — enables Adzuna external job source)
# Get free API keys at https://developer.adzuna.com/
# ADZUNA_APP_ID=your_adzuna_app_id
# ADZUNA_APP_KEY=your_adzuna_app_key

# JSearch / RapidAPI (optional — enables Google Jobs aggregator, US jobs)
# Subscribe free at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch (200 req/mo free)
# RAPIDAPI_KEY=your_rapidapi_key

# TheirStack (optional — largest job + technographic database, 200 free credits)
# Get API key at https://app.theirstack.com/settings/api-keys
# THEIRSTACK_API_KEY=your_theirstack_api_key

# Feature flags
# Master gate for recruiter API surface. Keep false for candidate-only launch.
ENABLE_RECRUITER_SURFACE=false
ENABLE_RECRUITER_AGENT_ARENA=false
ENABLE_FEED=false
ENABLE_CLAUDE_CONNECTOR=false

# Database SSL (production-only; managed Postgres needs ssl=require)
DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true  # set true if you have a known CA

# Alternative to discrete DB_* vars — standard for Render/Railway/Heroku/Neon
# DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require

# Optional pool tuning
# DB_POOL_MAX=10
# DB_POOL_MIN=0

# Public base URL of the frontend (used for password-reset, OAuth callbacks)
FRONTEND_URL=http://localhost:3000

# AI cost controls — model used for the OpenAI-direct job-enhance routes
# (gpt-4o-mini is ~95% cheaper than gpt-4 with similar quality for these formatting tasks)
# OPENAI_JOB_MODEL=gpt-4o-mini
