# ---------------------------------------------------------------
# ApplyPilot backend secrets. Copy to .env and fill in.
# ---------------------------------------------------------------

# Anthropic / Claude API — used by every LLM call.
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Which Claude model to use. Sonnet is a good default for cost/quality.
# Valid values include:
#   claude-opus-4-6
#   claude-sonnet-4-6   (recommended)
#   claude-haiku-4-5-20251001
APPLYPILOT_MODEL=claude-sonnet-4-6

# Postgres connection (the applypilot_* tables documented in db/schema.sql).
DATABASE_URL=postgres://user:pass@localhost:5432/profileai

# Shared secret used to verify the JWT that the frontend sends on every
# /api/applypilot/* request. Must match the main auth service.
JWT_SECRET=change-me

# Port the HTTP server listens on.
PORT=5010
